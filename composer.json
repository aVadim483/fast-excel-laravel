{
    "name": "avadim/fast-excel-laravel",
    "description": "Lightweight and very fast XLSX Excel Spreadsheet Export/Import for Laravel",
    "keywords": [
        "excel",
        "xlsx",
        "PHPExcel",
        "spreadsheet",
        "laravel",
        "export",
        "import",
        "ms office",
        "office 2007"
    ],
    "type": "library",
    "homepage": "https://github.com/aVadim483/fast-excel-laravel",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "avadim\\FastExcelLaravel\\": "./src/FastExcelLaravel"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "avadim\\FastExcelLaravel\\Test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "avadim/fast-excel-writer": "^6.14",
        "avadim/fast-excel-reader": "^4.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5.3|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "avadim\\FastExcelLaravel\\Providers\\ExcelServiceProvider"
            ],
            "aliases": {
                "Excel": "avadim\\FastExcelLaravel\\Facades\\Excel"
            }
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
